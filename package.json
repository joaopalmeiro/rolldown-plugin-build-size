    "publint": "0.3.24",
    "rolldown": "1.2.9",
    "tsdown": "0.22.5",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "rolldown": "^1.0.0",
    "vite": "^8.0.0"
